# --- Database ---
# Local dev / docker-compose default shown below. For a free, permanent hosted
# Postgres with pgvector, use Neon (neon.tech) and paste its connection string
# here with the postgresql+psycopg2:// prefix, e.g.:
# postgresql+psycopg2://user:pass@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/rag_chatbot

# --- Embeddings: "local" (free, sentence-transformers/all-MiniLM-L6-v2) or "openai" ---
EMBEDDING_PROVIDER=local

# --- Generation: required for actual LLM answers; without it the API
# falls back to returning the raw top chunk so the pipeline is still
# testable end-to-end ---
# GENERATION_PROVIDER: "openai" or "groq"
# Groq has a free tier with no billing method required (get a key at
# console.groq.com) — good default if you don't want any risk of a bill.
GENERATION_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Only used when GENERATION_PROVIDER=openai
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4o-mini

# --- Retrieval tuning ---
TOP_K=5
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE_TOKENS=350
CHUNK_OVERLAP_TOKENS=60

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:3000
